, 3.0989494, 1.0980258, 1.747968, 2.261951, 1.4874711, 1.5117414, 2.3098361, 1.8106092, 2.1085107, 2.2260246, 2.6126244, 1.8847933, 0.85622025], [2.8648431, 1.9828807, 1.9999368, 1.2213836, 1.9743752, 1.153388, 1.2989018, 1.3274161, 0.837089, 1.9383171, 2.0394695, 1.98208, 2.0134895, 1.9159678, 2.2817473, 2.9293194, 2.2091763], [1.8215287, 1.7796928, 1.9564465, 1.8352726, 1.9294394, 1.3114029, 1.7749006, 1.7333182, 2.0715392, 1.9649007, 1.7310061, 1.9316417, 2.016533, 1.9576869, 1.9306552, 2.0213487, 2.9981403], [3.0548708, 1.9796404, 1.6373937, 2.2981067, 0.32991132, 0.87902755, 0.987808, 1.8575329, 1.0425854, 0.7866029, 1.9665692, 2.2955945, 2.0360394, 1.3390919, 2.9051933, 3.0006242, 1.869808], [1.4446595, 1.5809402, 1.5951282, 3.0332851, 0.20278412, 1.1636716, 1.5100273, 2.5633857, 2.8674114, 1.1131783, 2.1112747, 3.5859628, 2.0148008, 0.5133461, 2.5199337, 1.9213165, 3.5628662], [3.815207, 3.4786325, 1.9581136, 0.825773, 1.9573205, 1.0089797, 0.10636581, 2.8870163, 0.22638564, 1.7381419, 2.3348765, 1.5546508, 1.3727268, 1.4586182, 3.1660724, 1.2924286, 0.70862377], [3.9108717, 3.248445, 1.7435961, 1.1459086, 3.7660375, 0.7654462, 0.1489111, 3.8305416, 0.23730104, 1.6802365, 2.4557753, 1.3429424, 1.2747285, 2.0303407, 3.3285613, 1.5809294, 1.1896758], [0.9902571, 1.0347301, 1.9774858, 2.501606, 3.355609, 3.3917232, 3.1437957, 1.9724866, 3.0546083, 2.9404778, 2.0801744, 1.8651952, 2.10528, 2.7915711, 2.0793185, 1.7186011, 3.0941267], [1.0345871, 1.054329, 1.9500062, 2.285375, 3.1485255, 3.4736648, 3.072002, 1.9831069, 3.0081906, 3.1409194, 2.0316525, 2.0400846, 2.234941, 2.8964844, 2.1915653, 1.7963444, 3.19229], [1.9161484, 1.9375098, 2.076988, 1.3797537, 2.7643657, 1.0491469, 1.1018612, 2.0063715, 1.9754719, 1.7564052, 1.8991915, 1.1495969, 2.247149, 1.9204518, 2.3011076, 2.9678257, 3.4935417], [3.1840787, 2.2000659, 2.1229868, 1.2880304, 2.607101, 0.8939571, 1.0592288, 2.263923, 1.0297848, 1.6776216, 2.104188, 1.1601336, 2.2719364, 1.8332072, 2.8770757, 2.998447, 3.2737026]], "texts": ["\u826f\u5fc3\u5927\u7247\uff0c\u4e2d\u56fd\u52a8\u6f2b\u7684\u5e0c\u671b\uff01\uff01\uff01", "\u56fd\u6f2b\u826f\u5fc3 \u5e0c\u671b\u4f60\u6211\u7684\u68a6\u60f3\u90fd\u80fd\u5b9e\u73b0\u3002", "\u975e\u5e38\u4e0d\u9519\u5566\uff0c\u6545\u4e8b\u7565\u6b20\u903b\u8f91\uff0c\u4f46\u662f\u4eba\u8bbe\u753b\u9762\u90fd\u8d85\u8d5e\u7684\uff0c\u826f\u5fc3\u4e4b\u4f5c\uff01\uff01", "\u867d\u7136\u6545\u4e8b\u60c5\u8282\u6709\u70b9\u4fd7\u5957\uff0c\u90fd\u5728\u610f\u6599\u4e4b\u4e2d\uff0c\u4f46\u7ed3\u6784\u5b8c\u6574\uff0c\u8d77\u627f\u8f6c\u5408\u6070\u5230\u597d\u5904\uff0c\u4f46\u5b9e\u5c5e\u826f\u5fc3\u4e4b\u4f5c", "\u56fd\u4ea7\u52a8\u753b\u4e5f\u7b97\u662f\u5c3d\u529b\u4e4b\u4f5c\u4e86\u3002\u753b\u9762\u7b97\u505a\u5230\u4e86\u80fd\u505a\u5230\u7684\u6700\u597d\u3002\u4f46\u662f\u5dee\u8ddd\u4f9d\u7136\u660e\u663e\u3002\u5267\u60c5\u4e5f\u662f\u77ed\u677f\u3002", "\u6709\u4eba\u8bf4\u8ddf\u5916\u56fd\u52a8\u753b\u7535\u5f71\u6bd4\u8fd8\u662f\u8fa3\u9e21\uff0c\u4f46\u662f\u81f3\u5c11\u80fd\u770b\u5230\u662f\u5728\u7528\u5fc3\u505a\u52a8\u753b\u4e86\uff0c\u7b97\u662f\u56fd\u4ea7\u52a8\u753b\u7535\u5f71\u7684\u9e21\u5934\u4e86\u3002\u5267\u60c5\u662f\u786c\u4f24\uff0c\u7279\u522b\u662f\u7ed3\u5c3e\u6709\u70b9\u65e9\u6cc4", "You examined the communiques; you saw the evidence of China's growth since the 1978 reform and opening-up policy.", "She examined the communiques; she saw the evidence of China's growth since the 1978 reform and opening-up policy.", "She will contemplate the shield-like properties of the waterproof and allergen-proof bed covering; it's an investment in health.", "She will notice the water-resistant material and allergen protection of the bed covering; it's a guard for health.", "In our country, there had been a considerable debate regarding the reintroduction of wolves.", "We had a big debate about reintroducing wolves in our country.", "\u58eb\u5175\u5728\u6218\u573a\u4e0a\u6740\u654c\u7684\u529f\u52b3\u6ca1\u6709\u5956\u8d4f\uff0c\u800c\u90a3\u4e9b\u4e3a\u79c1\u5bb6\u4e89\u6597\u7684\u52c7\u58eb\u5374\u5f97\u5230\u8363\u8a89\u548c\u5730\u4f4d\uff0c\u8fd9\u6837\uff0c\u8981\u60f3\u6c42\u5f97\u6c11\u4f17\u52aa\u529b\u4f5c\u6218\u6297\u654c\uff0c\u4e0d\u53bb\u4e3a\u79c1\u5229\u800c\u4e89\u6597\uff0c\u90a3\u662f\u4e0d\u53ef\u80fd\u7684\u3002", "\u5f53\u5175\u7684\u5728\u524d\u7ebf\u62fc\u6b7b\u6740\u654c\u6bdb\u90fd\u635e\u4e0d\u7740\uff0c\u4e3a\u79c1\u5bb6\u4e89\u6597\u7684\u52c7\u58eb\u5012\u662f\u6709\u5934\u6709\u8138\u3001\u5403\u9999\u559d\u8fa3\u7684\u3002\u4f60\u8bf4\u8fd9\u60c5\u51b5\uff0c\u8fd8\u6307\u671b\u5927\u5bb6\u4f19\u513f\u5356\u547d\u6297\u654c\u3001\u4e0d\u4e3a\u79c1\u5229\u62a2\u7834\u5934\uff1f\u6839\u672c\u4e0d\u53ef\u80fd\u561b\uff01", "\u8fd9\u5c31\u4f7f\u5f97\u4ed6\u201c\u4e0d\u5f97\u590d\u82e5\u5e73\u65f6\u4e4b\u9ad8\u89c6\u9614\u6b65\uff0c\u62e9\u53ef\u4e3a\u800c\u540e\u4e3a\uff0c\u56fa\u5b9c\u7a0d\u5584\u5176\u804c\u201d\u3002\u53f2\u8f7d\u4ed6\u5728\u4efb\u5927\u5174\u6c34\u5229\uff0c\u201c\u758f\u6c34\u4e3a\u767e\u6e20\u4e5d\u5830\uff0c\u4ee5\u64ad\u8282\u539f\u59d4\uff0c\u5f97\u4e0a\u7530\u4e03\u5341\u9877\u201d\u3002", "\u65af\u5883\u4e4b\u4e0b\uff0c\u5176\u201c\u4e0d\u5f97\u590d\u82e5\u5e73\u65f6\u4e4b\u9ad8\u89c6\u9614\u6b65\uff0c\u62e9\u53ef\u4e3a\u800c\u540e\u4e3a\uff0c\u56fa\u5b9c\u7a0d\u5584\u5176\u804c\u201d\u3002\u9752\u53f2\u8d6b\u7136\u8f7d\u5176\u5fb7\u653f\uff0c\u79fb\u5c71\u7406\u6c34\uff0c\u51b3\u58c5\u5bfc\u6ede\uff0c\u201c\u758f\u6c34\u4e3a\u767e\u6e20\u4e5d\u5830\uff0c\u4ee5\u64ad\u8282\u539f\u59d4\u201d\uff0c\u7ec8\u6da6\u6cfd\u818f\u8174\uff0c\u5f97\u4e0a\u7530\u4e03\u5341\u9877\u3002", "\u563f\u563f\uff0c\u90a3\u6211\u4eec\u5feb\u56de\u8001\u7239\u90a3\u8fb9\u53bb\u5427\uff0c\u8bf4\u4e0d\u5b9a\u63d0\u5c14\u624e\u5fb7\u4e5f\u9192\u8fc7\u6765\u5566\u3002", "\u563f\u563f\uff0c\u90a3\u6211\u4eec\u5feb\u8fd4\u56de\u8001\u7239\u90a3\u91cc\u5427\uff0c\u6216\u8bb8\u63d0\u5c14\u624e\u5fb7\u4e5f\u5df2\u82cf\u9192\u3002", "\u5f52\u6839\u7ed3\u5e95\uff0c\u6d3b\u7740\u624d\u6709\u673a\u4f1a\u3002\u5982\u679c\u4ee5\u540e\u6709\u9700\u8981\uff0c\u6211\u613f\u610f\u4e0e\u4f60\u5408\u4f5c\u3002", "\u552f\u6709\u751f\u5b58\u65b9\u6709\u5e0c\u671b\uff0c\u82e5\u65e5\u540e\u6709\u6240\u9700\u6c42\uff0c\u6211\u613f\u4e0e\u4f60\u643a\u624b\u5408\u4f5c\u3002"]}